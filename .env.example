# Hindsight Cloud (https://ui.hindsight.vectorize.io) or self-hosted. Leave HINDSIGHT_URL empty to run on the local ledger.
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK=dejavu-demo
# Optional: Groq writes the 2-sentence briefing. Verdicts never depend on it.
GROQ_API_KEY=
# Optional: also call Hindsight reflect on every review (slower, shows a synthesized briefing)
DEJAVU_REFLECT=
